  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid action-blue button for Check, Next, See score and Open the lesson.",
      "html": "<button class=\"ds-btn-primary\">Check</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border:0;border-radius:12px;background:var(--accent,#2453e6);color:#fff;font:600 15px/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .2s,transform .2s}.ds-btn-primary:hover{background:var(--accent-hover,#1c44c4)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#2453e6);outline-offset:2px}.ds-btn-primary:disabled{background:var(--surface-2,#eef0f4);color:var(--ink-3,#636b79);cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White bordered button for secondary actions such as the PDF guide download.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 15V3\"/><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><path d=\"m7 10 5 5 5-5\"/></svg>Learning guide (PDF)</a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border:1px solid var(--line-strong,#cdd2da);border-radius:12px;background:#fff;color:var(--ink,#14161b);font:600 15px/1.2 Geist,ui-sans-serif,system-ui,sans-serif;text-decoration:none;transition:border-color .2s}.ds-btn-secondary:hover{border-color:var(--ink-3,#636b79)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#2453e6);outline-offset:2px}"
    },
    {
      "name": "Answer Options",
      "kind": "custom",
      "refersTo": "answer-option",
      "description": "Large tappable answers: unselected, selected, correct, wrong.",
      "html": "<div class=\"ds-answers\"><button class=\"ds-answer\">to go</button><button class=\"ds-answer is-selected\">going</button><button class=\"ds-answer is-correct\">going <span>&#10003;</span></button><button class=\"ds-answer is-wrong\">go <span>&#10005;</span></button></div>",
      "css": ".ds-answers{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:520px}.ds-answer{display:flex;justify-content:space-between;align-items:center;min-height:48px;padding:12px 16px;border:2px solid var(--line,#e3e6eb);border-radius:12px;background:#fff;color:var(--ink,#14161b);font:500 16px Geist,ui-sans-serif,system-ui,sans-serif;text-align:left;cursor:pointer;transition:border-color .2s,background-color .2s}.ds-answer:hover{border-color:var(--line-strong,#cdd2da);background:var(--surface,#f6f7f9)}.ds-answer:focus-visible{outline:2px solid var(--accent,#2453e6);outline-offset:2px}.ds-answer.is-selected{border-color:var(--accent,#2453e6);background:var(--accent-soft,#ebf0fe);color:var(--accent-ink,#1a3fb3)}.ds-answer.is-correct{border-color:var(--good,#0f7a4f);background:var(--good-soft,#e5f5ec);color:#0b5a3a}.ds-answer.is-wrong{border-color:var(--bad,#c42b37);background:var(--bad-soft,#fdecee);color:#8f1d27}"
    },
    {
      "name": "Feedback Panel",
      "kind": "custom",
      "refersTo": "feedback-correct",
      "description": "Explained feedback after Check; green when right, red when wrong.",
      "html": "<div class=\"ds-feedback\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0f7a4f\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg><div><p class=\"ds-feedback-title\">Correct!</p><p>Enjoy is followed by the -ING form.</p></div></div><div class=\"ds-feedback is-wrong\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#c42b37\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></svg><div><p class=\"ds-feedback-title\">Not quite.</p><p>Decide takes TO + verb: decided to go.</p></div></div>",
      "css": ".ds-feedback{display:flex;gap:12px;margin-top:16px;padding:14px 16px;border-radius:12px;background:var(--good-soft,#e5f5ec);color:#0b5a3a;font:400 15px/1.6 Geist,ui-sans-serif,system-ui,sans-serif;max-width:520px}.ds-feedback svg{flex-shrink:0;margin-top:2px}.ds-feedback p{margin:0}.ds-feedback-title{font-weight:600}.ds-feedback.is-wrong{background:var(--bad-soft,#fdecee);color:#8f1d27}"
    },
    {
      "name": "Word Chips",
      "kind": "chip",
      "refersTo": "word-chip",
      "description": "Draggable or tappable words in SortBuckets and SentenceBuilder; lifted shadow only while dragged.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">avoid</button><button class=\"ds-chip is-selected\">decide</button><button class=\"ds-chip is-right\">enjoy &#10003;</button><button class=\"ds-chip is-wrong\">let &#10005;</button><span class=\"ds-chip is-lifted\">promise</span></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 12px;border:1px solid var(--line-strong,#cdd2da);border-radius:8px;background:#fff;color:var(--ink,#14161b);font:500 15px Geist,ui-sans-serif,system-ui,sans-serif;box-shadow:0 1px 0 rgb(20 22 27/.06);cursor:grab;transition:background-color .15s,border-color .15s,box-shadow .15s}.ds-chip:hover{border-color:var(--ink-3,#636b79)}.ds-chip:focus-visible{outline:2px solid var(--accent,#2453e6);outline-offset:2px}.ds-chip.is-selected{border-color:var(--accent,#2453e6);background:var(--accent,#2453e6);color:#fff}.ds-chip.is-right{border-color:rgb(15 122 79/.4);background:var(--good-soft,#e5f5ec);color:#0b5a3a;box-shadow:none}.ds-chip.is-wrong{border-color:rgb(196 43 55/.4);background:var(--bad-soft,#fdecee);color:#8f1d27;box-shadow:none}.ds-chip.is-lifted{border-color:var(--ink,#14161b);box-shadow:0 8px 24px rgb(20 22 27/.18);cursor:grabbing}"
    },
    {
      "name": "Verb Picker",
      "kind": "chip",
      "refersTo": "verb-picker",
      "description": "Pill radio group that drives PatternMorph; active is solid ink.",
      "html": "<div class=\"ds-picker\"><button class=\"ds-pick is-active\">enjoy</button><button class=\"ds-pick\">decided</button><button class=\"ds-pick\">told me</button><button class=\"ds-pick\">made me</button></div>",
      "css": ".ds-picker{display:flex;flex-wrap:wrap;gap:8px}.ds-pick{padding:6px 14px;border:1px solid var(--line-strong,#cdd2da);border-radius:9999px;background:#fff;color:var(--ink-2,#474e5c);font:500 14px Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:border-color .2s,color .2s}.ds-pick:hover{border-color:var(--ink-3,#636b79);color:var(--ink,#14161b)}.ds-pick:focus-visible{outline:2px solid var(--accent,#2453e6);outline-offset:2px}.ds-pick.is-active{border-color:var(--ink,#14161b);background:var(--ink,#14161b);color:#fff}"
    },
    {
      "name": "PatternMorph Sentence",
      "kind": "custom",
      "refersTo": "verb-picker",
      "description": "Signature: verb 2 in its pattern hue on tint, with numeral badge and formula label.",
      "html": "<div class=\"ds-morph\"><p class=\"ds-morph-line\">They enjoy <span class=\"ds-morph-v2\">going</span> out.</p><p class=\"ds-morph-label\"><span class=\"ds-badge\">1</span>Pattern 1: verb + -ING</p></div>",
      "css": ".ds-morph{padding:28px;border:1px solid var(--line,#e3e6eb);border-radius:12px;background:#fff;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-morph-line{margin:0;font-size:48px;font-weight:600;line-height:1.15;letter-spacing:-.03em;color:var(--ink,#14161b)}.ds-morph-v2{padding:0 .12em;border-radius:6px;background:var(--p1-soft,#e6f2e6);color:var(--p1,#2e7d32)}.ds-morph-label{display:flex;align-items:center;gap:10px;margin:20px 0 0;font-size:14px;font-weight:500;color:var(--ink-2,#474e5c)}.ds-badge{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 6px;border-radius:6px;background:var(--p1,#2e7d32);color:#fff;font-size:12px;font-weight:600}"
    },
