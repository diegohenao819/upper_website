      "html": "<div class=\"ds-callout\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"/><path d=\"M9 18h6\"/><path d=\"M10 22h4\"/></svg><div><p class=\"ds-callout-title\">There is no magic rule</p><p>Learn each verb with its partner: not just enjoy, but enjoy + -ING.</p></div></div>",
      "css": ".ds-callout{display:flex;gap:14px;padding:16px 20px;border-radius:12px;background:var(--surface,#f6f7f9);color:var(--ink-2,#474e5c);font:400 16px/1.6 Geist,ui-sans-serif,system-ui,sans-serif;max-width:560px}.ds-callout svg{flex-shrink:0;margin-top:2px;color:var(--ink,#14161b)}.ds-callout p{margin:0}.ds-callout-title{font-weight:600;color:var(--ink,#14161b)}"
